{
  // Static assets only: no Worker script, so nothing here can run code or call a model.
  "name": "nodewitness-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "nodewitness.williamniu.dev", "custom_domain": true }
  ]
}
